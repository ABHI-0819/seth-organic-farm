# syntax=docker/dockerfile:1
# ==============================================================================
# Seth Organic Farm - Production Monolithic Spree Rails Dockerfile
# Multi-stage build with Ruby 3.3-slim, Asset Precompilation & Non-Root User
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base Ruby Environment
# ------------------------------------------------------------------------------
FROM ruby:3.3-slim AS base

WORKDIR /rails

ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test"

# Install runtime dependencies (libpq for postgresql, vips for ImageProcessing)
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      curl \
      libpq5 \
      libvips \
      tzdata && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# ------------------------------------------------------------------------------
# Stage 2: Build Stage (Gems & Asset Precompilation)
# ------------------------------------------------------------------------------
FROM base AS build

# Install packages needed to build native gems and compile assets
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      pkg-config \
      nodejs \
      npm && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Copy Gemfile and lockfile
COPY Gemfile Gemfile.lock ./

# Install Ruby gems
RUN bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
    bundle exec bootsnap precompile --gemfile

# Copy application source code
COPY . .

# Precompile bootsnap code for faster boot times
RUN bundle exec bootsnap precompile app/ lib/

# Precompile assets with dummy SECRET_KEY_BASE so database is not required at build time
RUN SECRET_KEY_BASE_DUMMY=1 \
    SECRET_KEY_BASE=dummy_secret_for_asset_precompilation_only \
    RAILS_SERVE_STATIC_FILES=true \
    bin/rails assets:precompile

# ------------------------------------------------------------------------------
# Stage 3: Final Production Image
# ------------------------------------------------------------------------------
FROM base

# Create non-root rails user and group
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash

# Copy installed bundle from build stage
COPY --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"

# Copy compiled application code and precompiled assets
COPY --from=build --chown=rails:rails /rails /rails

# Set ownership of writable directories
RUN mkdir -p /rails/storage /rails/tmp /rails/log && \
    chown -R rails:rails /rails/storage /rails/tmp /rails/log

USER rails:rails

# Expose internal Puma port
EXPOSE 3000

# Default entrypoint and command
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]

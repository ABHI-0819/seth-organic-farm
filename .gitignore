# ==============================================================================
# Seth Organic Farm - Production .gitignore
# Covers Ruby on Rails 8, Spree Commerce, Next.js / Node, Docker & Secrets
# ==============================================================================

# --- Rails & Security Credentials (NEVER COMMIT KEYS) ---
/config/master.key
/config/credentials/*.key
/config/credentials.yml.enc.bak

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
!.env.production.sample

# --- ActiveStorage & Upload Artifacts ---
/storage/*
!/storage/.keep
/public/storage
/public/uploads

# --- Rails Assets & Cache ---
/public/assets
/public/packs
/public/packs-test
/node_modules/
/yarn-error.log
/yarn.lock
/.pnp
.pnp.*

# --- Rails Logs, Temporary Files & PIDs ---
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
/tmp/cache/*
/tmp/sockets/*
*.pid
*.seed

# --- Next.js & Frontend Build Outputs ---
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# --- Testing & E2E Reports ---
/coverage/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# --- Operating System & IDE Cache ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.claude/
.gemini/

# --- SSL Certificates & Private Keys ---
*.pem
*.key
*.crt
*.cert

# --- Docker & Compose Overrides ---
docker-compose.override.yml
.docker-cache/
